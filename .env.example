# Copy to .env and fill in your email provider's SMTP settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Verified sender address or SMTP account address
SMTP_FROM=
# Hotel inbox that receives guest feedback
FEEDBACK_TO=

# Set the permanent public website URL when deploying (used for SEO links).
# With no value, canonical and sitemap URLs use the incoming request origin.
SITE_URL=

# Optional persistent path for feedback and subscriber JSON storage.
# Default: the project's data folder. Use persistent storage when hosting.
HOTEL_DATA_DIR=

# Local development defaults to JSON files. Netlify automatically selects Blobs.
# Set to netlify only when using the Netlify runtime or authenticated Blobs CLI.
HOTEL_STORAGE_DRIVER=

# Netlify email delivery uses HTTPS with a verified Resend sending domain.
RESEND_API_KEY=
EMAIL_FROM=
# FEEDBACK_TO above is the hotel recipient for both SMTP and Resend.

# Optional only for secure local migration/CLI access; never expose in browser code.
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# Protected /admin/reviews dashboard. Generate locally with npm run admin:setup.
ADMIN_REVIEW_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# A strong plain password can be used instead of a hash in hosting secret settings.
ADMIN_REVIEW_PASSWORD=
